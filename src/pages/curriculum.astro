---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
---

<BaseLayout
  title={`Currículo Profissional (CV) — ${SITE.author}`}
  description={`Currículo de ${SITE.author}. Graduando em Ciência da Computação pela UERJ com foco em Visão Computacional, Engenharia de Software e Sistemas.`}
>
  <div class="cv-wrapper">
    <!-- Action Controls (Hidden on print) -->
    <header class="cv-top-bar no-print hairline-box">
      <div class="cv-spec font-mono">
        <span class="status-hire font-mono">[● DISPONÍVEL: ESTÁGIO / JÚNIOR • RJ OU REMOTO]</span>
        <span class="sep no-mobile">•</span>
        <span class="no-mobile">VERSÃO: 2026.Q4</span>
      </div>
      <div class="cv-actions">
        <button type="button" class="print-btn font-mono" onclick="window.print()">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          [IMPRIMIR / GERAR PDF ATS]
        </button>
      </div>
    </header>

    <!-- Plain-Text Style Formatted CV Content -->
    <article class="cv-document hairline-box">
      <!-- Header -->
      <section class="cv-header-block hairline-divider">
        <div class="cv-status-banner font-mono no-print">
          // STATUS ATUAL: {SITE.availability.fullText}
        </div>
        <h1 class="cv-name">{SITE.author.toUpperCase()}</h1>
        <div class="cv-headline font-mono">DESENVOLVEDOR BACKEND &amp; MACHINE LEARNING // UERJ</div>
        <div class="cv-contact-row font-mono">
          <span>EMAIL: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></span>
          <span>•</span>
          <span>TEL: <a href={`tel:${SITE.phone}`}>{SITE.phone}</a></span>
          <span>•</span>
          <span>WEB: <a href={SITE.url}>{SITE.domain}</a></span>
          <span>•</span>
          <span>GH: <a href={SITE.github.url} target="_blank" rel="noopener noreferrer">github.com/{SITE.github.handle}</a></span>
          <span>•</span>
          <span>LI: <a href={SITE.linkedin.url} target="_blank" rel="noopener noreferrer">linkedin.com/in/{SITE.linkedin.handle}</a></span>
          <span>•</span>
          <span>LOCAL: {SITE.location.formattedUpper}</span>
        </div>
      </section>

      <!-- Executive Synthesis -->
      <section class="cv-section hairline-divider">
        <h2 class="cv-sec-title font-mono">// 01. PERFIL</h2>
        <p class="cv-text">
          Graduando em <strong>Ciência da Computação (UERJ, previsão de conclusão: 2028)</strong>, com foco em desenvolvimento backend, APIs e infraestrutura Linux. Experiência prática com <strong>Go, Python, PostgreSQL</strong>, orquestração de containers com <strong>Podman/Caddy</strong> e contribuição contínua em projetos open source (<strong>NixOS</strong>).
        </p>
      </section>

      <!-- Core Competencies -->
      <section class="cv-section hairline-divider">
        <h2 class="cv-sec-title font-mono">// 02. COMPETÊNCIAS &amp; STACK TÉCNICA</h2>
        <div class="cv-skills-grid font-mono">
          <div class="skill-category">
            <span class="category-name">LINGUAGENS:</span>
            <span class="category-items">Python, Golang, R, Flutter, TypeScript.</span>
          </div>
          <div class="skill-category">
            <span class="category-name">FRONTEND &amp; FRAMEWORKS:</span>
            <span class="category-items">SvelteKit, Svelte, Astro, Elixir / Phoenix LiveView.</span>
          </div>
          <div class="skill-category">
            <span class="category-name">BACKEND, INFRA &amp; BANCOS DE DADOS:</span>
            <span class="category-items">Linux, Fedora, NixOS, Podman (Quadlets), Git, Caddy, SQLite, PostgreSQL.</span>
          </div>
          <div class="skill-category">
            <span class="category-name">ML &amp; ANÁLISE DE DADOS:</span>
            <span class="category-items">YOLO11-seg, SAM 2.1, ONNX Runtime, OpenCV, Modelagem Estatística em R.</span>
          </div>
        </div>
      </section>

      <!-- Professional, Volunteering & Research Experience -->
      <section class="cv-section hairline-divider">
        <h2 class="cv-sec-title font-mono">// 03. VOLUNTARIADO, PESQUISA &amp; INFRAESTRUTURA</h2>

        <!-- Bloco 1: UFSM -->
        <div class="cv-job-block">
          <div class="job-header">
            <span class="job-title">Pesquisador Voluntário em Análise de Dados</span>
            <span class="job-period font-mono">jul. de 2025 – Atual</span>
          </div>
          <div class="job-company font-mono">Universidade Federal de Santa Maria (UFSM)</div>
          <ul class="job-achievements">
            <li>
              Desenvolvimento de pipelines de ingestão, limpeza e modelagem estatística em R para previsão epidemiológica de incidência de Chikungunya (CHIKV) na região de Belo Horizonte (MG).
            </li>
          </ul>
        </div>

        <!-- Bloco 2: NixOS -->
        <div class="cv-job-block">
          <div class="job-header">
            <span class="job-title">Desenvolvedor Open Source // nixpkgs</span>
            <span class="job-period font-mono">set. de 2021 – Atual</span>
          </div>
          <div class="job-company font-mono">NixOS</div>
          <ul class="job-achievements">
            <li>
              Desenvolvimento, manutenção e revisão de pacotes para o <code>nixpkgs</code>, o repositório oficial de pacotes da distribuição Linux declarativa NixOS.
            </li>
          </ul>
        </div>

        <!-- Bloco 3: Prato do Dia (UERJ) -->
        <div class="cv-job-block">
          <div class="job-header">
            <span class="job-title">Pesquisador de Iniciação Científica // Visão Computacional</span>
            <span class="job-period font-mono">mai. de 2024 – Atual</span>
          </div>
          <div class="job-company font-mono">Universidade do Estado do Rio de Janeiro (UERJ) • Projeto Prato do Dia (<a href="https://github.com/uerj-prato-do-dia" target="_blank" rel="noopener noreferrer">github.com/uerj-prato-do-dia</a>)</div>
          <ul class="job-achievements">
            <li>
              Pipeline de segmentação de instâncias focado em taxonomia alimentar brasileira. Treinamento e quantização de modelos YOLO11-seg integrados a rotinas OpenCV para inferência, processamento e curadoria automatizada de datasets.
            </li>
            <li>
              Aplicativo mobile em Flutter consumindo API em Python/FastAPI.
            </li>
          </ul>
        </div>

        <!-- Bloco 4: Infraestrutura Self-Hosted & Homelab -->
        <div class="cv-job-block">
          <div class="job-header">
            <span class="job-title">Infraestrutura Self-Hosted &amp; Homelab</span>
            <span class="job-period font-mono">out. de 2026 – Atual</span>
          </div>
          <div class="job-company font-mono">Servidor Tachibana • Fedora, Podman, Caddy</div>
          <ul class="job-achievements">
            <li>
              Administração de um servidor Fedora Linux, orquestrando +15 serviços em rede fechada utilizando Podman Quadlets (daemonless) para isolamento e segurança.
            </li>
          </ul>
        </div>
      </section>

      <!-- Projects & Showcase -->
      <section class="cv-section hairline-divider">
        <h2 class="cv-sec-title font-mono">// 04. PROJETOS EM DESTAQUE</h2>
        <ul class="cv-projects-list">
          <li>
            <strong>Prato do Dia (<a href="https://github.com/uerj-prato-do-dia" target="_blank" rel="noopener noreferrer">github.com/uerj-prato-do-dia</a>):</strong> Pipeline de segmentação de instâncias focado em taxonomia alimentar brasileira (YOLO11-seg, OpenCV, Python) e aplicativo mobile em Flutter.
          </li>
          <li>
            <strong>Letterboxd Wall (<a href="https://boxd.gabe.tec.br" target="_blank" rel="noopener noreferrer">boxd.gabe.tec.br</a>):</strong> API REST em Go para geração dinâmica de colagens de filmes via parsing resiliente de RSS, download concorrente de cartazes, cache em memória com TTL e streaming direto em JPEG; proxy de imagens com CORS e frontend interativo com renderização em Canvas via Svelte 5 (TypeScript).
          </li>
          <li>
            <strong>O Enigma Diário (<a href="https://puzzles.gabe.tec.br" target="_blank" rel="noopener noreferrer">puzzles.gabe.tec.br</a>):</strong> Interface web reativa em SvelteKit (TypeScript) empacotada em container com persistência em SQLite.
          </li>
          <li>
            <strong>Roleta de Decisões (<a href="https://roleta.gabe.tec.br" target="_blank" rel="noopener noreferrer">roleta.gabe.tec.br</a>) &amp; Jogo da Forca (<a href="https://forca.gabe.tec.br" target="_blank" rel="noopener noreferrer">forca.gabe.tec.br</a>):</strong> Aplicações multiplayer em tempo real (Go + Svelte 5 WebSockets e Elixir + Phoenix LiveView).
          </li>
        </ul>
      </section>

      <!-- Education, Certifications & Languages -->
      <section class="cv-section">
        <h2 class="cv-sec-title font-mono">// 05. FORMAÇÃO, CERTIFICAÇÕES &amp; IDIOMAS</h2>
        <div class="cv-edu-grid font-mono">
          <div>
            <strong>Ciência da Computação — Universidade Estadual do Rio de Janeiro (UERJ)</strong><br />
            set. de 2022 – Atual • Previsão de Conclusão: 2028
          </div>
          <div>
            <strong>CERTIFICAÇÕES:</strong><br />
            • Introdução à editoração em LaTeX — UERJ (jan. de 2025)<br />
            • Desenvolvimento guiado por tipos — Universidade Federal do ABC (UFABC) (mar. de 2022)
          </div>
          <div>
            <strong>IDIOMAS:</strong> Português: Nativo • Inglês: Intermediário (B1) • Mandarim: Iniciante (A1)
          </div>
        </div>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .cv-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cv-top-bar {
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cv-spec {
    font-size: 0.75rem;
    color: var(--text-dim);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .status-hire {
    color: var(--text);
    font-weight: 700;
    letter-spacing: 0.04em;
    background-color: var(--surface-secondary, rgba(255, 255, 255, 0.05));
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
  }

  .cv-status-banner {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    padding: 0.4rem 0.6rem;
    background: var(--bg);
    border: 1px dashed var(--border);
    margin-bottom: 0.5rem;
  }

  .print-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    padding: 0.4rem 0.75rem;
    background-color: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
  }

  .print-btn:hover {
    border-color: var(--text);
  }

  .cv-document {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    background-color: var(--surface);
  }

  .cv-header-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 1.5rem;
  }

  .cv-name {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .cv-headline {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .cv-contact-row {
    font-size: 0.78rem;
    color: var(--text-dim);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.35rem;
  }

  .cv-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 1.75rem;
  }

  .cv-sec-title {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--text);
    margin: 0;
    padding: 0;
    border: none;
  }

  .cv-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text);
    margin: 0;
  }

  .cv-skills-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.82rem;
  }

  .skill-category {
    display: flex;
    gap: 0.5rem;
    line-height: 1.45;
  }

  .category-name {
    color: var(--text-dim);
    width: 170px;
    flex-shrink: 0;
  }

  .category-items {
    color: var(--text);
  }

  .cv-job-block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .cv-job-block:last-child {
    margin-bottom: 0;
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .job-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
  }

  .job-period {
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  .job-company {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .job-achievements {
    list-style: square;
    padding-left: 1.25rem;
    margin: 0.35rem 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--text);
  }

  .cv-projects-list {
    list-style: square;
    padding-left: 1.25rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--text);
  }

  .cv-edu-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text);
  }

  @media print {
    .cv-wrapper {
      gap: 0;
    }

    .cv-document {
      border: none !important;
      padding: 0 !important;
      background: #ffffff !important;
      color: #000000 !important;
    }

    .cv-section {
      padding-bottom: 1rem;
    }

    .cv-sec-title {
      color: #000000 !important;
    }
  }
</style>
