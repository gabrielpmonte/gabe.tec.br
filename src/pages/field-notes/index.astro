---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FilterBanner from "../../components/FilterBanner.astro";
import EmptyState from "../../components/EmptyState.astro";
import FieldNoteCard from "../../components/FieldNoteCard.astro";
import { getSortedFieldNotes } from "../../utils/content";
import { SITE } from "../../site.config";

const notes = await getSortedFieldNotes();
---

<BaseLayout
  title="Notas de Campo & Topografia"
  description={`Registros de montanhismo, trilhas e perfis topográficos de ${SITE.author}. Coordenadas e elevação.`}
>
  <div class="field-archive-container">
    <header class="field-header hairline-box">
      <h1 class="field-title">Notas de Campo &amp; Topografia</h1>
      <p class="field-desc">
        Registros de expedições, travessias e perfis de elevação com coordenadas
        geográficas catalogadas (WGS 84) e metadados de campo.
      </p>
    </header>

    <FilterBanner
      bannerId="field-status-banner"
      countId="field-visible-count"
      labelId="field-active-tag"
      clearBtnId="field-clear-btn"
      totalCount={notes.length}
      entityLabel="REGISTROS"
    />

    <div class="field-grid" id="field-grid">
      {
        notes.map((entry, index) => (
          <FieldNoteCard
            entry={entry}
            variant="full"
            interactiveTags={true}
            priority={index === 0 ? "high" : index === 1 ? true : false}
          />
        ))
      }
    </div>

    <EmptyState
      id="field-empty-state"
      message="// NENHUMA EXPEDIÇÃO ENCONTRADA PARA A TAG SELECIONADA."
    />
  </div>
</BaseLayout>

<style>
  .field-archive-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .field-header {
    padding: 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .header-path {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .field-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0;
  }

  .field-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .field-spec-summary {
    font-size: 0.72rem;
    color: var(--text-dim);
    padding-top: 0.75rem;
    border-top: var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 600px) {
    .field-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { setupFilterManager } from "../../scripts/filter-manager";

  setupFilterManager({
    rootSelector: ".field-archive-container",
    topButtonSelector: ".tag-filter-btn",
    buttonValueAttr: "data-tag",
    buttonParamKeyAttr: "data-param",
    defaultParamKey: "tag",
    inlineButtonSelector: ".tag-inline-btn",
    inlineButtonValueAttr: "data-tag",
    inlineButtonParamKey: "tag",
    itemSelector: ".field-item",
    itemMatcher: (item, filters) => {
      const activeTag = filters.tag;
      if (!activeTag || activeTag === "all") return true;
      const itemTags = (item.getAttribute("data-tags") || "")
        .split(",")
        .map((s) => s.trim());
      return itemTags.includes(activeTag);
    },
    bannerId: "field-status-banner",
    bannerCountId: "field-visible-count",
    bannerLabelId: "field-active-tag",
    formatBannerLabel: (filters) => (filters.tag ? `#${filters.tag}` : ""),
    clearBtnId: "field-clear-btn",
    emptyStateId: "field-empty-state",
    listContainerId: "field-grid",
  });
</script>
