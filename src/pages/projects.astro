---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../site.config";
import { PROJECTS } from "../data/projects";

const projects = PROJECTS;
---

<BaseLayout
  title={`Projetos de Engenharia & Demonstrações — ${SITE.author}`}
  description={`Portfólio de projetos de ${SITE.author}: aplicações interativas, pesquisas em visão computacional na UERJ e infraestrutura homelab.`}
>
  <div class="projects-container">
    <header class="projects-header hairline-box">
      <div class="header-path font-mono">
        // {SITE.domain.toUpperCase()} / PROJECTS
      </div>
      <h1 class="projects-title">Projetos de Engenharia &amp; Demonstrações</h1>
      <p class="projects-desc">
        Seleção de softwares desenvolvidos, pesquisas aplicadas em visão
        computacional, aplicações hospedadas e infraestrutura autônoma.
      </p>

      <div class="hire-banner font-mono">
        <span class="hire-dot">●</span>
        <span>STATUS: {SITE.availability.fullText}</span>
      </div>
    </header>

    <div class="projects-grid">
      {
        projects.map((p, index) => (
          <article class="project-card hairline-box">
            <div class="card-top-bar font-mono">
              <span class="card-num">
                [{String(index + 1).padStart(2, "0")}]
              </span>
              <span class="card-category">{p.category}</span>
              {p.badge && <span class="card-badge">{p.badge}</span>}
              <span class="card-period">{p.period}</span>
            </div>

            <div class="card-body">
              <h2 class="card-title">{p.title}</h2>
              <p class="card-desc">{p.description}</p>

              <div class="card-highlights">
                <span class="highlights-title font-mono">
                  // DESTAQUES DE ENGENHARIA:
                </span>
                <ul>
                  {p.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </div>

              <div class="card-stack font-mono">
                <span class="stack-label">STACK:</span>
                <div class="tags-row">
                  {p.stack.map((s) => (
                    <span class="stack-tag">{s}</span>
                  ))}
                </div>
              </div>
            </div>

            <footer class="card-footer font-mono">
              {p.liveUrl && (
                <a
                  href={p.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="action-btn live-btn no-underline"
                >
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="square"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                  [ACESSAR DEMO]
                </a>
              )}

              {p.githubUrl && (
                <a
                  href={p.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="action-btn no-underline"
                >
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="square"
                  >
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                  [CÓDIGO GITHUB]
                </a>
              )}

              {p.internalUrl && (
                <a href={p.internalUrl} class="action-btn no-underline">
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="square"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                  </svg>
                  [VER ARQUITETURA]
                </a>
              )}
            </footer>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .projects-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .projects-header {
    padding: 2.25rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background-color: var(--surface);
  }

  .header-path {
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .projects-title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0;
  }

  .projects-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 720px;
    margin: 0;
  }

  .hire-banner {
    margin-top: 0.5rem;
    padding: 0.5rem 0.85rem;
    background: var(--bg);
    border: 1px dashed var(--border);
    font-size: 0.75rem;
    color: var(--text);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
  }

  .hire-dot {
    color: var(--text);
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .project-card {
    background-color: var(--surface);
    display: flex;
    flex-direction: column;
  }

  .card-top-bar {
    padding: 0.85rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.75rem;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
    background-color: var(--bg);
  }

  .card-num {
    color: var(--text-dim);
    font-weight: 700;
  }

  .card-category {
    color: var(--text);
    font-weight: 600;
  }

  .card-badge {
    color: var(--text);
    background-color: var(--surface);
    border: 1px solid var(--border);
    padding: 0.15rem 0.45rem;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }

  .card-period {
    color: var(--text-dim);
    margin-left: auto;
  }

  .card-body {
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0;
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  .card-highlights {
    background-color: var(--bg);
    border: 1px solid var(--border);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .highlights-title {
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .card-highlights ul {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text);
  }

  .card-stack {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.78rem;
    margin-top: 0.25rem;
    flex-wrap: wrap;
  }

  .stack-label {
    color: var(--text-dim);
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stack-tag {
    background-color: var(--bg);
    border: 1px solid var(--border);
    padding: 0.15rem 0.5rem;
    color: var(--text);
  }

  .card-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background-color: var(--bg);
    flex-wrap: wrap;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    padding: 0.4rem 0.75rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .action-btn:hover {
    border-color: var(--text);
    background-color: var(--bg);
  }

  .live-btn {
    font-weight: 700;
    border-color: var(--text);
  }
</style>
