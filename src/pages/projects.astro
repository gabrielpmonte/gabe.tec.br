---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../site.config";
import { PROJECTS } from "../data/projects";

const projects = PROJECTS;
---

<BaseLayout
  title={`Projetos de Engenharia & Demonstrações — ${SITE.author}`}
  description={`Portfólio de projetos de ${SITE.author}: aplicações interativas, pesquisas em visão computacional na UERJ e infraestrutura homelab.`}
>
  <div class="projects-container">
    <header class="projects-header hairline-box">
      <div class="header-path font-mono">
        // {SITE.domain.toUpperCase()} / PROJECTS
      </div>
      <h1 class="projects-title">Projetos de Engenharia &amp; Demonstrações</h1>
      <p class="projects-desc">
        Seleção de softwares desenvolvidos, pesquisas aplicadas em visão
        computacional, aplicações hospedadas e infraestrutura autônoma.
      </p>

      <div class="hire-banner font-mono">
        <span class="hire-dot">●</span>
        <span>STATUS: {SITE.availability.fullText}</span>
      </div>
    </header>

    <section class="showcase-controls hairline-box" aria-label="Filtros da vitrine de projetos">
      <div class="controls-row">
        <div class="search-wrap">
          <span class="search-prefix font-mono">&gt;_</span>
          <input
            id="projects-search"
            type="text"
            class="search-field font-mono"
            placeholder="Filtrar por título, stack ou descrição... [/]"
            autocomplete="off"
          />
          <button
            id="projects-search-clear"
            type="button"
            class="search-clear-btn font-mono"
            hidden
            aria-label="Limpar busca"
          >
            [ESC]
          </button>
        </div>

        <select id="projects-group" class="group-select font-mono" aria-label="Filtrar por categoria">
          <option value="all">Todas as categorias ({projects.length})</option>
          <option value="apps">Apps &amp; Jogos ({projects.filter((p) => p.group === "apps").length})</option>
          <option value="research">Pesquisa &amp; CLI ({projects.filter((p) => p.group === "research").length})</option>
          <option value="infra">Infra &amp; Design ({projects.filter((p) => p.group === "infra").length})</option>
        </select>
      </div>

      <div id="projects-count" class="controls-meta font-mono">
        Exibindo {projects.length} de {projects.length} projetos
      </div>
    </section>

    <div id="projects-grid" class="projects-grid">
      {
        projects.slice(0, 3).map((p, index) => (
          <article
            id={p.title.toLowerCase().includes("prato do dia") ? "prato-do-dia" : undefined}
            class="project-card hairline-box"
            data-group={p.group}
            data-search={`${p.title} ${p.category} ${p.description} ${p.stack.join(" ")} ${p.badge || ""}`.toLowerCase()}
          >
            <div class="card-top-bar font-mono">
              <span class="card-num">
                [{String(index + 1).padStart(2, "0")}]
              </span>
              <span class="card-category">{p.category}</span>
              {p.badge && <span class="card-badge">{p.badge}</span>}
              <span class="card-period">{p.period}</span>
            </div>

            <div class="card-body">
              <h2 class="card-title">{p.title}</h2>
              <p class="card-desc">{p.description}</p>

              <div class="card-highlights">
                <span class="highlights-title font-mono">
                  // DESTAQUES DE ENGENHARIA:
                </span>
                <ul>
                  {p.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </div>

              <div class="card-stack font-mono">
                <span class="stack-label">STACK:</span>
                <div class="tags-row">
                  {p.stack.map((s) => (
                    <span class="stack-tag">{s}</span>
                  ))}
                </div>
              </div>
            </div>

            <footer class="card-footer font-mono">
              {p.liveUrl && (
                <a
                  href={p.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="action-btn live-btn no-underline"
                >
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="square"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                  [ACESSAR DEMO]
                </a>
              )}

              {p.githubUrl && (
                <a
                  href={p.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="action-btn no-underline"
                >
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="square"
                  >
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                  [CÓDIGO GITHUB]
                </a>
              )}

              {p.internalUrl && (
                <a href={p.internalUrl} class="action-btn no-underline">
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="square"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                  </svg>
                  [VER ARQUITETURA]
                </a>
              )}
            </footer>
          </article>
        ))
      }
    </div>

    <div id="projects-compact-grid" class="compact-grid">
      {
        projects.slice(3).map((p) => (
          <article
            class="compact-card hairline-box project-item"
            data-group={p.group}
            data-search={`${p.title} ${p.category} ${p.description} ${p.stack.join(" ")} ${p.badge || ""}`.toLowerCase()}
          >
            <div class="compact-head font-mono">
              <span class="compact-cat">{p.category}</span>
              <span class="compact-period">{p.period}</span>
            </div>
            <h2 class="compact-title">
              <a href={p.liveUrl || p.githubUrl || p.internalUrl || "/projects"} target={p.liveUrl || p.githubUrl ? "_blank" : undefined} rel={p.liveUrl || p.githubUrl ? "noopener noreferrer" : undefined} class="compact-link">
                {p.title}
              </a>
            </h2>
            <p class="compact-desc">{p.description}</p>
            <div class="compact-foot font-mono">
              <span class="compact-stack">{p.stack.slice(0, 4).join(" · ")}</span>
              {p.liveUrl && (
                <a href={p.liveUrl} target="_blank" rel="noopener noreferrer" class="compact-action">
                  Demo ↗
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .projects-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .projects-header {
    padding: 2.25rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background-color: var(--surface);
  }

  .header-path {
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .projects-title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0;
  }

  .projects-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 720px;
    margin: 0;
  }

  .hire-banner {
    margin-top: 0.5rem;
    padding: 0.5rem 0.85rem;
    background: var(--bg);
    border: 1px dashed var(--border);
    font-size: 0.75rem;
    color: var(--text);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
  }

  .hire-dot {
    color: #10b981;
    text-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .project-card {
    background-color: var(--surface);
    display: flex;
    flex-direction: column;
  }

  .card-top-bar {
    padding: 0.85rem 1.5rem 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.75rem;
    flex-wrap: wrap;
  }

  .card-num {
    color: var(--text-dim);
    font-weight: 700;
  }

  .card-category {
    color: var(--text);
    font-weight: 600;
  }

  .card-badge {
    color: var(--text);
    background-color: var(--surface);
    border: 1px solid var(--border);
    padding: 0.15rem 0.45rem;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }

  .card-period {
    color: var(--text-dim);
    margin-left: auto;
  }

  .card-body {
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0;
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  .card-highlights {
    padding: 0.5rem 0 0.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .highlights-title {
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .card-highlights ul {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text);
  }

  .card-stack {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.78rem;
    margin-top: 0.25rem;
    flex-wrap: wrap;
  }

  .stack-label {
    color: var(--text-dim);
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stack-tag {
    color: var(--text-muted);
    padding: 0;
  }

  .card-footer {
    padding: 0 1.5rem 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    padding: 0.4rem 0.75rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .action-btn:hover {
    border-color: var(--text);
    background-color: var(--bg);
  }

  .live-btn {
    font-weight: 700;
    border-color: var(--tc-amber, var(--text));
    color: var(--tc-amber, var(--text));
  }

  .showcase-controls {
    padding: 1rem 1.25rem;
    background-color: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .controls-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
  }

  .search-wrap {
    flex: 1 1 280px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--bg);
    border: 1px solid var(--border);
    padding: 0.45rem 0.75rem;
  }

  .search-wrap:focus-within {
    border-color: var(--tc-blue, var(--text));
  }

  .search-prefix {
    color: var(--tc-amber, var(--text-dim));
    font-size: 0.8rem;
  }

  .search-field {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font-size: 0.82rem;
  }

  .search-clear-btn {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.7rem;
    padding: 0.15rem 0.4rem;
    cursor: pointer;
  }

  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .filter-tab {
    background-color: var(--bg);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.72rem;
    padding: 0.4rem 0.65rem;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .filter-tab:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .filter-tab.active {
    background-color: var(--surface-active);
    border-color: var(--tc-amber, var(--text));
    color: var(--tc-amber, var(--text));
    font-weight: 700;
  }

  .group-select {
    background-color: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 0.78rem;
    padding: 0.45rem 0.75rem;
    cursor: pointer;
  }

  .group-select:focus {
    outline: none;
    border-color: var(--tc-blue, var(--text));
  }

  .compact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 720px) {
    .compact-grid {
      grid-template-columns: 1fr;
    }
  }

  .compact-card {
    background-color: var(--surface);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: border-color 140ms ease-out;
  }

  .compact-card:hover {
    border-color: var(--border-strong);
  }

  .compact-head {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: var(--text-dim);
  }

  .compact-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }

  .compact-link {
    color: var(--text);
    text-decoration: none;
  }

  .compact-link:hover {
    text-decoration: underline;
    color: var(--tc-amber, var(--text));
  }

  .compact-desc {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin: 0;
    flex-grow: 1;
  }

  .compact-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: var(--text-dim);
    padding-top: 0.25rem;
  }

  .compact-action {
    color: var(--tc-amber, var(--text));
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }

  .compact-action:hover {
    text-decoration: underline;
  }

  .controls-meta {
    font-size: 0.72rem;
    color: var(--text-dim);
  }
</style>

<script>
  function initProjectsShowcase() {
    const searchInput = document.getElementById("projects-search") as HTMLInputElement | null;
    const clearBtn = document.getElementById("projects-search-clear") as HTMLButtonElement | null;
    const groupSelect = document.getElementById("projects-group") as HTMLSelectElement | null;
    const countEl = document.getElementById("projects-count");
    const cards = Array.from(document.querySelectorAll<HTMLElement>("#projects-grid .project-card, #projects-compact-grid .compact-card"));

    if (!searchInput || !groupSelect || !cards.length) return;

    function applyFilters() {
      const q = (searchInput?.value || "").trim().toLowerCase();
      const activeGroup = groupSelect?.value || "all";
      if (clearBtn) clearBtn.hidden = q.length === 0;

      let visible = 0;
      for (const card of cards) {
        const group = card.dataset.group || "";
        const hay = card.dataset.search || "";
        const okGroup = activeGroup === "all" || group === activeGroup;
        const okQuery = !q || hay.includes(q);
        const show = okGroup && okQuery;
        card.hidden = !show;
        if (show) visible++;
      }

      if (countEl) {
        countEl.textContent = `Exibindo ${visible} de ${cards.length} projetos`;
      }
    }

    groupSelect.addEventListener("change", applyFilters);
    searchInput.addEventListener("input", applyFilters);
    clearBtn?.addEventListener("click", () => {
      searchInput.value = "";
      applyFilters();
      searchInput.focus();
    });

    if (!(window as any).__projectsKeyListener) {
      (window as any).__projectsKeyListener = true;
      window.addEventListener("keydown", (e: KeyboardEvent) => {
        const input = document.getElementById("projects-search") as HTMLInputElement | null;
        if (!input) return;
        const tag = (document.activeElement?.tagName || "").toUpperCase();
        if (e.key === "/" && tag !== "INPUT" && tag !== "TEXTAREA") {
          e.preventDefault();
          input.focus();
          input.select();
        } else if (e.key === "Escape" && document.activeElement === input) {
          input.value = "";
          input.dispatchEvent(new Event("input"));
          input.blur();
        }
      });
    }
  }

  document.addEventListener("astro:page-load", initProjectsShowcase);
</script>
