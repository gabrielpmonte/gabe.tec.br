---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import ArticleColophon from "../../components/ArticleColophon.astro";
import { render } from "astro:content";
import { getPublishedWritings } from "../../utils/content";
import { formatISODate } from "../../utils/date";
import {
  getContentMetrics,
  getEffectiveUpdatedDate,
  getHistoryUrl,
  getSeriesContext,
} from "../../utils/metrics";

export async function getStaticPaths() {
  const posts = await getPublishedWritings();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const { wordCount, readingMinutes } = getContentMetrics(post);
const effectiveUpdatedDate = getEffectiveUpdatedDate(post);
const historyUrl = getHistoryUrl(post);
const seriesContext = getSeriesContext(post, allPosts);
---

<BaseLayout
  title={`${post.data.title} — Artigo Técnico`}
  description={post.data.description}
  type="article"
  publishDate={post.data.publishDate}
  updatedDate={effectiveUpdatedDate ?? undefined}
  tags={post.data.tags}
>
  <article class="article-container">
    <Breadcrumb
      backHref="/writing"
      backLabel="VOLTAR AO ÍNDICE DE ARTIGOS"
      currentSlug={post.id}
    />

    <!-- Header Section -->
    <header class="article-header hairline-box">
      <div class="meta-line font-mono">
        <span class="meta-label">DATA:</span>
        <time datetime={post.data.publishDate.toISOString()} class="meta-val">
          {formatISODate(post.data.publishDate)}
        </time>
        {
          effectiveUpdatedDate && (
            <>
              <span class="meta-sep">•</span>
              <span class="meta-label">REV:</span>
              <time
                datetime={effectiveUpdatedDate.toISOString()}
                class="meta-val"
              >
                {formatISODate(effectiveUpdatedDate)}
              </time>
            </>
          )
        }
        <span class="meta-sep">•</span>
        <span class="meta-val">{readingMinutes} MIN LEITURA</span>
        <span class="meta-sep">•</span>
        <span class="meta-val">{wordCount} PALAVRAS</span>
        {
          (historyUrl || post.data.repoUrl) && (
            <span class="meta-links">
              {historyUrl && (
                <a
                  href={historyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="meta-link"
                  title="Ver histórico de revisões no GitHub"
                >
                  HISTÓRICO
                </a>
              )}
              {post.data.repoUrl && (
                <a
                  href={post.data.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="meta-link"
                  title="Ver código-fonte do projeto"
                >
                  CÓDIGO
                </a>
              )}
            </span>
          )
        }
      </div>

      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-subtitle">{post.data.description}</p>

      <div class="article-tags font-mono">
        {
          post.data.tags.map((tag) => (
            <a
              href={`/writing?tag=${encodeURIComponent(tag)}`}
              class="tag-mono"
              title={`Filtrar artigos por #${tag}`}
            >
              #{tag}
            </a>
          ))
        }
      </div>
    </header>

    <div class="article-body-layout">
      <!-- Floating / Sticky Table of Contents -->
      <TableOfContents headings={headings} />

      <!-- Main Editorial Content Flow -->
      <div class="article-content-flow">
        <div class="prose-content">
          <Content />
        </div>

        {
          seriesContext && (
            <nav
              class="series-nav hairline-box"
              aria-label="Navegação da série"
            >
              <div class="series-header font-mono">
                <span>
                  // SÉRIE: {seriesContext.name.toUpperCase()} — PARTE{" "}
                  {seriesContext.part}
                  {seriesContext.total ? ` DE ${seriesContext.total}` : ""}
                </span>
              </div>
              <ol class="series-list">
                {seriesContext.items.map((item) => (
                  <li
                    class={
                      item.id === post.id
                        ? "series-item is-current"
                        : "series-item"
                    }
                  >
                    <span class="series-part font-mono">
                      P{String(item.data.series?.part ?? 0).padStart(2, "0")}
                    </span>
                    {item.id === post.id ? (
                      <span class="series-current-title">
                        {item.data.title}
                      </span>
                    ) : (
                      <a href={`/writing/${item.id}`} class="series-link">
                        {item.data.title}
                      </a>
                    )}
                  </li>
                ))}
              </ol>
              {(seriesContext.prev || seriesContext.next) ? (
                <div class="series-pager font-mono">
                  {seriesContext.prev ? (
                    <a
                      href={`/writing/${seriesContext.prev.id}`}
                      class="series-pager-link"
                    >
                      &larr; Parte {seriesContext.prev.data.series?.part}
                    </a>
                  ) : (
                    <span />
                  )}
                  {seriesContext.next && (
                    <a
                      href={`/writing/${seriesContext.next.id}`}
                      class="series-pager-link"
                    >
                      Parte {seriesContext.next.data.series?.part} &rarr;
                    </a>
                  )}
                </div>
              ) : (
                <div class="series-note font-mono">
                  Próxima parte desta série em produção.
                </div>
              )}
            </nav>
          )
        }

        <!-- Footer Colophon -->
        <ArticleColophon backHref="/writing" backLabel="Voltar para /writing" />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .article-header {
    padding: 2rem 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .meta-line {
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .meta-label {
    color: var(--text-dim);
  }

  .meta-sep {
    color: var(--border-strong);
  }

  .meta-val {
    color: var(--text);
  }

  .meta-links {
    margin-left: auto;
    display: inline-flex;
    gap: 0.75rem;
  }

  .meta-link {
    color: var(--text-dim);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
  }

  .meta-link:hover {
    color: var(--text);
    text-decoration-color: var(--text);
  }

  .series-nav {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .series-header {
    font-size: 0.72rem;
    color: var(--text-dim);
    letter-spacing: 0.04em;
  }

  .series-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .series-item {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .series-item.is-current {
    color: var(--text);
    font-weight: 600;
  }

  .series-part {
    font-size: 0.72rem;
    color: var(--text-dim);
    flex-shrink: 0;
  }

  .series-link {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
  }

  .series-link:hover {
    color: var(--text);
    text-decoration-color: var(--text);
  }

  .series-pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.75rem;
    border-top: var(--hairline);
    font-size: 0.75rem;
  }

  .series-pager-link {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
  }

  .series-pager-link:hover {
    color: var(--text);
    text-decoration-color: var(--text);
  }

  .series-note {
    font-size: 0.72rem;
    color: var(--text-dim);
    padding-top: 0.65rem;
    border-top: var(--hairline);
  }

  .article-title {
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .article-subtitle {
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin: 0;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 0.5rem;
    border-top: var(--hairline);
  }

  /* Two Column Layout with TOC */
  .article-body-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .article-content-flow {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .prose-content {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--text);
  }

  .prose-content :global(strong) {
    font-weight: 600;
  }

  .prose-content :global(h2) {
    font-size: 1.35rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    scroll-margin-top: 2rem;
  }

  .prose-content :global(h3) {
    font-size: 1.15rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 2rem;
  }

  .prose-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose-content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.5rem 0 0.75rem 0;
    border: var(--hairline);
    background-color: var(--surface);
  }

  .prose-content :global(p > em:only-child) {
    display: block;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-top: -0.5rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 900px) {
    .article-body-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
