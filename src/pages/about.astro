---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../site.config";
---

<BaseLayout
  title={`Sobre // ${SITE.author}`}
  description={`Trajetória técnica, ambiente operacional (/uses), homelab e projetos open source de ${SITE.author} (${SITE.domain}).`}
>
  <div class="about-container">
    <header class="about-header hairline-box">
      <div class="header-eyebrow font-mono">
        <span class="accent-dot" aria-hidden="true"></span>
        <span>PERFIL // {SITE.domain.toUpperCase()}</span>
      </div>
      <h1 class="about-name">{SITE.author}</h1>
      <div class="about-spec font-mono">
        <span>{SITE.title.toUpperCase()}</span>
        <span class="sep" aria-hidden="true">/</span>
        <span>{SITE.location.formattedUpper}</span>
      </div>
    </header>

    <div class="about-grid">
      <!-- Coluna Esquerda (1.4fr): Narrativa & Código Aberto -->
      <div class="about-main">
        <section class="about-card hairline-box">
          <header class="card-header">
            <span class="section-code font-mono">01 // TRAJETÓRIA</span>
            <h2 class="section-title">Trajetória &amp; Foco Técnico</h2>
          </header>

          <div class="prose-stack">
            <p class="lead-text">
              Graduando em <strong>Ciência da Computação pela UERJ</strong>
              (previsão: 2028), com atuação centrada em desenvolvimento backend,
              APIs resilientes e infraestrutura Linux.
            </p>
            <p class="body-text">
              No dia a dia construo serviços com <strong>Go, Python e PostgreSQL</strong>,
              empacoto pacotes declarativos no <strong>NixOS</strong> (<code>nixpkgs</code>)
              e mantenho aplicações em produção no catálogo de{" "}
              <a href="/projects" class="inline-link">projetos</a>.
            </p>
            <p class="body-text">
              Na pesquisa acadêmica, integro pipelines estatísticos em R para
              modelagem epidemiológica de Chikungunya na <strong>UFSM</strong> e
              desenvolvo visão computacional aplicada (YOLO11-seg, SAM 2.1 e
              Flutter) na Iniciação Científica da <strong>UERJ</strong>.
            </p>
            <p class="body-text">
              Em casa opero o homelab{" "}
              <a href="/notes/tachibana-homelab" class="inline-link">Tachibana</a>,
              orquestrando mais de 15 serviços rootless com Podman Quadlets,
              Caddy e observabilidade contínua. O histórico completo de formação
              e experiências está no{" "}
              <a href="/curriculum" class="inline-link">currículo</a>.
            </p>
          </div>
        </section>

        <section class="about-card hairline-box">
          <header class="card-header">
            <span class="section-code font-mono">02 // REPOSITÓRIOS</span>
            <h2 class="section-title">Código Aberto</h2>
          </header>

          <div class="repo-list">
            <article class="repo-box hairline-box">
              <div class="repo-head font-mono">
                <a
                  href="https://puzzles.gabe.tec.br"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="repo-name"
                >
                  <span>puzzles.gabe.tec.br</span>
                  <svg class="ext-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M7 17L17 7M7 7h10v10" />
                  </svg>
                </a>
                <span class="repo-lang">SvelteKit / SQLite</span>
              </div>
              <p class="repo-desc">
                Plataforma diária de desafios lógicos e problemas computacionais
                auto-hospedada sob o domínio gabe.tec.br.
              </p>
            </article>

            <article class="repo-box hairline-box">
              <div class="repo-head font-mono">
                <a
                  href="https://github.com/uerj-prato-do-dia"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="repo-name"
                >
                  <span>uerj-prato-do-dia</span>
                  <svg class="ext-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M7 17L17 7M7 7h10v10" />
                  </svg>
                </a>
                <span class="repo-lang">Python / ONNX</span>
              </div>
              <p class="repo-desc">
                Pipeline de visão computacional (YOLO11 + SAM 2.1 ONNX) para
                detecção e segmentação de instâncias de alimentos em refeições.
              </p>
            </article>

            <article class="repo-box hairline-box">
              <div class="repo-head font-mono">
                <a
                  href={`${SITE.github.url}/gabe.tec.br`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="repo-name"
                >
                  <span>{SITE.github.handle}/gabe.tec.br</span>
                  <svg class="ext-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M7 17L17 7M7 7h10v10" />
                  </svg>
                </a>
                <span class="repo-lang">Astro / TypeScript</span>
              </div>
              <p class="repo-desc">
                Código-fonte deste portal estático de engenharia com tokens
                Cathode CSS, busca local Pagefind e zero clientes pesados.
              </p>
            </article>
          </div>
        </section>
      </div>

      <!-- Coluna Direita (1fr): Painel Lateral Vivo -->
      <aside class="about-aside">
        <section class="about-card hairline-box">
          <header class="card-header">
            <span class="section-code font-mono">/USES</span>
            <h2 class="section-title">Ambiente &amp; Ferramentas</h2>
          </header>

          <dl class="uses-list">
            <div class="uses-item">
              <dt class="uses-key font-mono">Estação &amp; Sistema</dt>
              <dd class="uses-val">
                Dual boot Fedora Linux (GNOME / Niri WM) e Windows 11,
                terminal-first com Alacritty, Zsh e editor Helix.
              </dd>
            </div>

            <div class="uses-item">
              <dt class="uses-key font-mono">Homelab (Tachibana &amp; Wired)</dt>
              <dd class="uses-val">
                Servidor local HP EliteDesk (i5-8500, Fedora Server)
                orquestrando mais de 15 serviços rootless via Podman Quadlets,
                proxy reverso Caddy, malha privada Tailscale e observabilidade
                com Beszel e Gatus.
              </dd>
            </div>

            <div class="uses-item">
              <dt class="uses-key font-mono">Stack Principal</dt>
              <dd class="uses-val">
                Go e Python no backend, PostgreSQL e SQLite para persistência,
                NixOS / <code>nixpkgs</code> para empacotamento declarativo e
                Astro / SvelteKit no frontend.
              </dd>
            </div>
          </dl>
        </section>

        <section class="about-card hairline-box">
          <header class="card-header">
            <span class="section-code font-mono">OFFLINE</span>
            <h2 class="section-title">Fora do Código</h2>
          </header>

          <p class="aside-prose">
            Nos fins de semana exploro trilhas no Rio de Janeiro, pratico
            fotografia documental e mantenho rotina diária de estudos de
            mandarim.
          </p>
        </section>

        <section class="about-card contact-card hairline-box">
          <header class="card-header">
            <span class="section-code font-mono">CONTATO</span>
            <h2 class="section-title">Contato</h2>
          </header>

          <div class="contact-list font-mono">
            <div class="contact-email-row">
              <a href={`mailto:${SITE.email}`} class="contact-link contact-primary">
                <span class="contact-label">E-MAIL</span>
                <span class="contact-handle">{SITE.email}</span>
              </a>
              <button
                type="button"
                class="copy-btn font-mono"
                data-copy-email={SITE.email}
                aria-label="Copiar endereço de e-mail"
              >
                <svg class="icon-copy" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="9" y="9" width="13" height="13" />
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                </svg>
                <svg class="icon-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span class="copy-text">Copiar</span>
              </button>
            </div>

            <a
              href={SITE.github.url}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link"
            >
              <span class="contact-label">GITHUB</span>
              <span class="contact-handle">github.com/{SITE.github.handle}</span>
              <svg class="ext-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M7 17L17 7M7 7h10v10" />
              </svg>
            </a>

            <a
              href={SITE.linkedin.url}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link"
            >
              <span class="contact-label">LINKEDIN</span>
              <span class="contact-handle">linkedin.com/in/{SITE.linkedin.handle}</span>
              <svg class="ext-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M7 17L17 7M7 7h10v10" />
              </svg>
            </a>
          </div>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  function initCopyButtons() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-copy-email]");

    buttons.forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";

      let resetTimer: number | undefined;

      btn.addEventListener("click", () => {
        const email = btn.dataset.copyEmail;
        if (!email) return;

        // Optimistic UI: feedback imediato sem aguardar promessa do clipboard
        btn.dataset.copied = "true";
        const label = btn.querySelector(".copy-text");
        if (label) label.textContent = "Copiado";

        if (resetTimer) window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          delete btn.dataset.copied;
          if (label) label.textContent = "Copiar";
        }, 1500);

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(email).catch(() => {});
        }
      });
    });
  }

  initCopyButtons();
  document.addEventListener("astro:page-load", initCopyButtons);
</script>

<style>
  .about-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-header {
    padding: 1.85rem 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background-color: var(--surface);
    border-left: 3px solid var(--accent);
  }

  .header-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: var(--text-dim);
    letter-spacing: 0.08em;
  }

  .accent-dot {
    width: 6px;
    height: 6px;
    background-color: var(--accent);
    flex-shrink: 0;
  }

  .about-name {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--text);
    margin: 0;
  }

  .about-spec {
    font-size: 0.78rem;
    color: var(--text-dim);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    letter-spacing: 0.04em;
  }

  .about-spec .sep {
    color: var(--accent);
    opacity: 0.85;
  }

  /* Asymmetric 1.4fr / 1fr Grid */
  .about-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .about-main,
  .about-aside {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
  }

  .about-card {
    padding: 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    background-color: var(--surface);
  }

  .card-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: 0.85rem;
    border-bottom: var(--hairline);
  }

  .section-code {
    font-size: 0.7rem;
    color: var(--accent);
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .section-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.015em;
    margin: 0;
    padding: 0;
    border: none;
  }

  /* Left Column: Narrative */
  .prose-stack {
    display: flex;
    flex-direction: column;
    gap: 1.05rem;
  }

  .lead-text {
    font-size: 1.02rem;
    line-height: 1.68;
    color: var(--text);
    font-weight: 450;
    margin: 0;
  }

  .body-text,
  .aside-prose {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0;
  }

  .inline-link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
    transition: color 0.12s ease;
  }

  .inline-link:hover {
    color: var(--accent);
  }

  /* Left Column: Open Source (3 cards) */
  .repo-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .repo-box {
    padding: 1.1rem 1.25rem;
    background-color: var(--bg);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: border-color 0.15s ease;
  }

  .repo-box:hover {
    border-color: var(--accent);
  }

  .repo-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .repo-name {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--text);
    text-decoration: none;
  }

  .repo-name:hover {
    color: var(--accent);
  }

  .ext-icon {
    opacity: 0.55;
    flex-shrink: 0;
    transition: transform 0.12s ease, opacity 0.12s ease;
  }

  .repo-name:hover .ext-icon,
  .contact-link:hover .ext-icon {
    opacity: 1;
    transform: translate(1px, -1px);
  }

  .repo-lang {
    font-size: 0.72rem;
    color: var(--text-dim);
  }

  .repo-desc {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }

  /* Right Column: /uses */
  .uses-list {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    margin: 0;
  }

  .uses-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-left: 0.85rem;
    border-left: 2px solid var(--border-strong);
    transition: border-color 0.15s ease;
  }

  .uses-item:hover {
    border-left-color: var(--accent);
  }

  .uses-key {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.02em;
  }

  .uses-val {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.58;
    color: var(--text-muted);
  }

  /* Right Column: Compact Contact */
  .contact-card {
    border-top: 2px solid var(--accent);
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    border-top: var(--hairline);
  }

  .contact-email-row {
    display: flex;
    align-items: stretch;
    border-bottom: var(--hairline);
    gap: 0.5rem;
  }

  .contact-email-row .contact-link {
    flex: 1;
    min-width: 0;
    border-bottom: none;
  }

  .contact-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-bottom: var(--hairline);
    text-decoration: none;
    color: var(--text);
    font-size: 0.8rem;
    transition: color 0.12s ease;
  }

  .contact-link:hover {
    color: var(--accent);
  }

  .contact-primary {
    justify-content: flex-start;
  }

  .contact-label {
    font-size: 0.7rem;
    color: var(--text-dim);
    letter-spacing: 0.06em;
    flex-shrink: 0;
    width: 64px;
  }

  .contact-handle {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    align-self: center;
    padding: 0.35rem 0.65rem;
    background-color: var(--bg);
    border: 1px solid var(--border-strong);
    color: var(--text);
    font-size: 0.72rem;
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color 0.12s ease, color 0.12s ease, background-color 0.12s ease;
  }

  .copy-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .copy-btn .icon-check {
    display: none;
  }

  .copy-btn[data-copied="true"] {
    border-color: var(--tc-emerald);
    color: var(--tc-emerald);
    background-color: var(--surface-active);
  }

  .copy-btn[data-copied="true"] .icon-copy {
    display: none;
  }

  .copy-btn[data-copied="true"] .icon-check {
    display: inline-block;
  }

  @media (max-width: 840px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .about-header,
    .about-card {
      padding: 1.35rem 1.25rem;
    }

    .about-name {
      font-size: 1.65rem;
    }

    .contact-email-row {
      flex-wrap: wrap;
      padding-bottom: 0.65rem;
    }

    .copy-btn {
      margin-left: 64px;
    }
  }
</style>
