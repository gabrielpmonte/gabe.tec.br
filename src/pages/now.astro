---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../site.config";
import nowSeed from "../data/now-seed.json";

const lastUpdated = "2026-11-16";
const seedBooks = nowSeed.reading?.items ?? [];
const seedNowPlaying = nowSeed.listening?.now_playing as {
  title?: string;
  artist?: string;
  album?: string;
  cover?: string;
} | null;
const seedAlbums = (nowSeed.listening?.recent_albums ?? []) as Array<{
  title: string;
  artist: string;
  cover?: string;
}>;
---

<BaseLayout
  title={`Agora — ${SITE.author}`}
  description={`O que ${SITE.author} está construindo, estudando e acompanhando no momento presente.`}
>
  <div class="now-page">
    <header class="now-header hairline-box">
      <div class="now-header-top">
        <h1>Agora</h1>
        <span class="now-live-badge font-mono">
          <span class="live-dot" aria-hidden="true">●</span>
          Atualizado em <time datetime={lastUpdated}>{lastUpdated}</time>
        </span>
      </div>
      <p class="meta font-mono">
        {SITE.location.city}, {SITE.location.state} · Inspirado em
        <a
          href="https://nownownow.com/about"
          target="_blank"
          rel="noopener noreferrer"
          class="accent-link">nownownow.com</a
        >
      </p>
    </header>

    <div class="now-grid">
      <div class="now-main">
        <section class="now-section">
          <h2>Construindo</h2>
          <ul class="build-list">
            <li class="build-item">
              <div class="build-head">
                <a href="/projects#prato-do-dia" class="item-link">
                  <strong>Prato do Dia (UERJ)</strong>
                </a>
                <span class="item-status font-mono">etapa: inferência cpu</span>
              </div>
              <p>
                Refinando a quantização e inferência em CPU (YOLO11-seg + OpenCV)
                para segmentação de alimentos e curadoria automatizada de datasets.
              </p>
            </li>

            <li class="build-item">
              <div class="build-head">
                <a href="/curriculum" class="item-link">
                  <strong>Pesquisa UFSM (CHIKV)</strong>
                </a>
                <span class="item-status font-mono">etapa: modelagem em R</span>
              </div>
              <p>
                Desenvolvendo pipelines de ingestão e modelagem estatística em R
                para previsão epidemiológica de Chikungunya em Belo Horizonte.
              </p>
            </li>

            <li class="build-item">
              <div class="build-head">
                <a href="/notes/tachibana-homelab" class="item-link">
                  <strong>Homelab Tachibana</strong>
                </a>
                <span class="item-status font-mono">etapa: quadlets + beszel</span>
              </div>
              <p>
                Consolidando serviços declarativos em Fedora com Podman Quadlets,
                Caddy, observabilidade via Beszel/Gatus/ntfy e atualizações automáticas.
              </p>
            </li>
          </ul>
        </section>

        <section class="now-section">
          <h2>Lendo &amp; Estudando</h2>
          <ul class="study-list">
            <li>
              <em>Designing Data-Intensive Applications</em> — replicação,
              particionamento e consenso em sistemas distribuídos.
            </li>
            <li>
              <em>Systems Performance (2nd Ed)</em> — metodologia USE, page cache
              e análise de latência de I/O em Linux.
            </li>
            <li>
              <em>The Linux Programming Interface</em> — chamadas POSIX, cgroups
              v2 e isolamento de processos.
            </li>
          </ul>
        </section>
      </div>

      <aside class="now-aside hairline-box" aria-label="Contexto e Estado Atual">
        <h2 class="aside-title font-mono">Contexto &amp; Estado Atual</h2>

        <div id="now-reading-slot" class="media-block" data-generated-at={nowSeed.generated_at}>
          <span class="block-label font-mono">Lendo no Kindle</span>
          {
            seedBooks.length > 0 ? (
              <div class="book-list">
                {seedBooks.map((book) => (
                  <a
                    href={book.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="book-item no-underline"
                  >
                    {book.cover && (
                      <img
                        src={book.cover}
                        alt={`Capa de ${book.title}`}
                        width="44"
                        height="66"
                        loading="lazy"
                        decoding="async"
                        class="book-cover"
                      />
                    )}
                    <div class="book-meta">
                      <span class="book-title">{book.title}</span>
                      <span class="book-author">{book.author}</span>
                    </div>
                  </a>
                ))}
              </div>
            ) : (
              <p class="media-empty">Nenhum livro em leitura no momento.</p>
            )
          }
        </div>

        <div id="now-listening-slot" class="media-block">
          <span class="block-label font-mono">Escutando</span>
          {
            seedNowPlaying ? (
              <div class="listening-now">
                <strong>{seedNowPlaying.title}</strong>
                <span>{seedNowPlaying.artist}</span>
              </div>
            ) : seedAlbums.length > 0 ? (
              <ul class="album-list">
                {seedAlbums.slice(0, 3).map((alb) => (
                  <li>
                    <strong>{alb.title}</strong> — {alb.artist}
                  </li>
                ))}
              </ul>
            ) : (
              <a
                href="https://radio.gabe.tec.br"
                target="_blank"
                rel="noopener noreferrer"
                class="accent-link media-fallback"
              >
                Airstation (radio.gabe.tec.br)
              </a>
            )
          }
        </div>

        <dl class="context-list">
          <div class="context-row">
            <dt class="font-mono">Ambiente</dt>
            <dd>Fedora / NixOS · Go &amp; Python</dd>
          </div>
          <div class="context-row">
            <dt class="font-mono">Foco da semana</dt>
            <dd>Quantização &amp; Podman Quadlets</dd>
          </div>
          <div class="context-row">
            <dt class="font-mono">Fora do terminal</dt>
            <dd>Corrida em trilha &amp; topografia (RJ)</dd>
          </div>
        </dl>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  async function hydrateNow() {
    const readingSlot = document.getElementById("now-reading-slot");
    const listeningSlot = document.getElementById("now-listening-slot");
    if (!readingSlot || !listeningSlot) return;

    const seedGeneratedAt = readingSlot.dataset.generatedAt || "";
    try {
      const resp = await fetch("https://api.gabe.tec.br/now.json", {
        cache: "default",
      });
      if (!resp.ok) return;
      const data = await resp.json();
      if (!data?.generated_at || data.generated_at <= seedGeneratedAt) return;

      if (data.reading?.status === "ok" && Array.isArray(data.reading.items) && data.reading.items.length > 0) {
        const list = document.createElement("div");
        list.className = "book-list";
        for (const book of data.reading.items) {
          const a = document.createElement("a");
          a.href = book.url;
          a.target = "_blank";
          a.rel = "noopener noreferrer";
          a.className = "book-item no-underline";
          if (book.cover) {
            const img = document.createElement("img");
            img.src = book.cover;
            img.alt = `Capa de ${book.title}`;
            img.width = 44;
            img.height = 66;
            img.loading = "lazy";
            img.decoding = "async";
            img.className = "book-cover";
            a.appendChild(img);
          }
          const meta = document.createElement("div");
          meta.className = "book-meta";
          const t = document.createElement("span");
          t.className = "book-title";
          t.textContent = book.title;
          const au = document.createElement("span");
          au.className = "book-author";
          au.textContent = book.author;
          meta.appendChild(t);
          meta.appendChild(au);
          a.appendChild(meta);
          list.appendChild(a);
        }
        readingSlot.innerHTML = '<span class="block-label font-mono">Lendo no Kindle</span>';
        readingSlot.appendChild(list);
      }

      if (data.listening?.status === "ok") {
        listeningSlot.innerHTML = '<span class="block-label font-mono">Escutando</span>';
        if (data.listening.now_playing) {
          const np = document.createElement("div");
          np.className = "listening-now";
          const st = document.createElement("strong");
          st.textContent = data.listening.now_playing.title || "";
          const ar = document.createElement("span");
          ar.textContent = data.listening.now_playing.artist || "";
          np.appendChild(st);
          np.appendChild(ar);
          listeningSlot.appendChild(np);
        } else if (Array.isArray(data.listening.recent_albums) && data.listening.recent_albums.length > 0) {
          const ul = document.createElement("ul");
          ul.className = "album-list";
          for (const alb of data.listening.recent_albums.slice(0, 3)) {
            const li = document.createElement("li");
            const st = document.createElement("strong");
            st.textContent = alb.title || "";
            li.appendChild(st);
            li.appendChild(document.createTextNode(` — ${alb.artist || ""}`));
            ul.appendChild(li);
          }
          listeningSlot.appendChild(ul);
        }
      }
    } catch {
      // Silent fallback: keep build-time seed rendered without errors
    }
  }

  document.addEventListener("astro:page-load", hydrateNow);
</script>

<style>
  .now-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .now-header {
    padding: 1.75rem 2rem;
    background-color: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .now-header-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .now-header h1 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0;
  }

  .now-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .live-dot {
    color: var(--tc-emerald, #10b981);
    font-size: 0.7rem;
  }

  .now-header .meta {
    font-size: 0.78rem;
    color: var(--text-dim);
    margin: 0;
  }

  .accent-link {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 140ms ease-out;
  }

  .accent-link:hover {
    color: var(--tc-amber, var(--text));
  }

  .now-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 2.25rem;
    align-items: start;
  }

  @media (max-width: 820px) {
    .now-grid {
      grid-template-columns: 1fr;
    }
  }

  .now-main {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .now-section h2 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 1rem 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .build-list,
  .study-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0;
    margin: 0;
  }

  .build-item {
    padding-left: 1rem;
    border-left: 2px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: border-color 140ms ease-out;
  }

  .build-item:hover {
    border-left-color: var(--tc-amber, var(--text));
  }

  .build-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .item-link {
    color: var(--text);
    text-decoration: none;
    transition: color 140ms ease-out;
  }

  .item-link:hover {
    color: var(--tc-amber, var(--text));
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .item-status {
    font-size: 0.72rem;
    color: var(--text-dim);
  }

  .build-item p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
    max-width: 65ch;
  }

  .study-list li {
    padding-left: 1rem;
    border-left: 2px solid var(--border);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 65ch;
  }

  .now-aside {
    padding: 1.5rem;
    background-color: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .aside-title {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.04em;
    margin: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .media-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .block-label {
    font-size: 0.72rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .book-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .book-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text);
    transition: color 140ms ease-out;
  }

  .book-item:hover .book-title {
    color: var(--tc-amber, var(--text));
    text-decoration: underline;
  }

  .book-cover {
    width: 44px;
    height: 66px;
    object-fit: cover;
    border: 1px solid var(--border);
    flex-shrink: 0;
    background-color: var(--bg);
  }

  .book-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .book-title {
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }

  .book-author {
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  .listening-now,
  .album-list {
    font-size: 0.86rem;
    color: var(--text-muted);
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .media-empty,
  .media-fallback {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .context-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0;
  }

  .context-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .context-row dt {
    font-size: 0.72rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .context-row dd {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0;
  }
</style>
