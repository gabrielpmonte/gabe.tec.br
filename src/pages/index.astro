---
import BaseLayout from "../layouts/BaseLayout.astro";
import WritingDenseItem from "../components/WritingDenseItem.astro";
import NoteCard from "../components/NoteCard.astro";
import FieldNoteCard from "../components/FieldNoteCard.astro";
import {
  getPublishedWritings,
  getSortedNotes,
  getSortedFieldNotes,
} from "../utils/content";
import { SITE } from "../site.config";
import { PROJECTS } from "../data/projects";

const allWritings = await getPublishedWritings();
const allNotes = await getSortedNotes();
const allFieldNotes = await getSortedFieldNotes();

const featuredProjects = PROJECTS.slice(0, 3);
const writings = allWritings.slice(0, 5);
const notes = allNotes.slice(0, 6);
const fieldNotes = allFieldNotes.slice(0, 3);
---

<BaseLayout title={SITE.defaultTitle} description={SITE.defaultDescription}>
  <div class="index-flow">
    <!-- Top Terminal Meta Header -->
    <header class="index-header hairline-box">
      <div class="header-status-line font-mono">
        <span class="prompt">&gt;_</span>
        <span class="host">{SITE.domain}</span>
        <span class="sep">:</span>
        <span class="path">~/index</span>
        <span class="badge">[READY]</span>
      </div>
      <p class="index-intro">
        Graduando em Ciência da Computação pela UERJ. Pesquisador de Iniciação
        Científica em visão computacional e segmentação de instâncias (YOLO11 +
        SAM 2.1). Autor de ferramentas open source (Scopio no PyPI) e operador
        de infraestrutura autônoma com Linux e NixOS.
      </p>
      <div class="index-hire-badge font-mono">
        <span class="dot">●</span>
        {SITE.availability.fullText}
      </div>
      <div class="quick-stats font-mono">
        <span>PROJETOS: <a href="/projects" class="underline">{PROJECTS.length} DESTAQUES</a></span>
        <span>•</span>
        <span>WRITING: <a href="/writing" class="underline">{allWritings.length} ARTIGOS</a></span>
        <span>•</span>
        <span>GARDEN: <a href="/notes" class="underline">{allNotes.length} NOTAS</a></span>
        <span>•</span>
        <span>FIELD: <a href="/field-notes" class="underline">{allFieldNotes.length} REGISTROS</a></span>
      </div>
    </header>

    <!-- Block 1: Featured Projects & Research -->
    <section class="section-block" aria-labelledby="sec-projects-title">
      <div class="section-header">
        <h2 id="sec-projects-title" class="section-title">
          <span class="title-code font-mono">[01]</span> Projetos em Destaque &amp; Pesquisa
        </h2>
        <a href="/projects" class="section-more font-mono no-underline">
          ver todos ({PROJECTS.length})
          <svg
            width="11"
            height="11"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="square"><path d="M7 17L17 7M7 7h10v10"></path></svg
          >
        </a>
      </div>

      <div class="featured-projects-grid">
        {
          featuredProjects.map((p, idx) => (
            <article class="featured-project-card hairline-box">
              <header class="card-top font-mono">
                <div class="card-meta">
                  <span class="card-index">[{String(idx + 1).padStart(2, "0")}]</span>
                  <span class="card-cat">{p.category}</span>
                </div>
                {p.badge && (
                  <div class="card-badge-row">
                    <span class="card-badge">{p.badge}</span>
                  </div>
                )}
              </header>

              <div class="card-content">
                <h3 class="project-heading">
                  <a href={p.liveUrl || p.githubUrl || "/projects"} class="project-title-link">
                    {p.title}
                  </a>
                </h3>
                <p class="project-summary">{p.description}</p>

                <div class="project-stack font-mono">
                  {p.stack.slice(0, 5).map((tech) => (
                    <span class="stack-chip">{tech}</span>
                  ))}
                  {p.stack.length > 5 && (
                    <span class="stack-more">+{p.stack.length - 5}</span>
                  )}
                </div>
              </div>

              <footer class="project-actions font-mono">
                {p.githubUrl && (
                  <a
                    href={p.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="action-link"
                  >
                    [GITHUB ↗]
                  </a>
                )}
                {p.liveUrl && (
                  <a
                    href={p.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="action-link live-accent"
                  >
                    [DEMO AO VIVO ↗]
                  </a>
                )}
                <a href="/projects" class="action-link detail-link">
                  [DETALHES]
                </a>
              </footer>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Block 2: Technical Writing Articles -->
    <section class="section-block" aria-labelledby="sec-writing-title">
      <div class="section-header">
        <h2 id="sec-writing-title" class="section-title">
          <span class="title-code font-mono">[02]</span> Artigos Técnicos Recentes
        </h2>
        <a href="/writing" class="section-more font-mono no-underline">
          ver todos ({allWritings.length})
          <svg
            width="11"
            height="11"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="square"><path d="M7 17L17 7M7 7h10v10"></path></svg
          >
        </a>
      </div>

      <div class="dense-list hairline-box">
        {writings.map((post) => <WritingDenseItem post={post} />)}
      </div>
    </section>

    <!-- Block 3: Digital Garden Recent Notes -->
    <section class="section-block" aria-labelledby="sec-notes-title">
      <div class="section-header">
        <h2 id="sec-notes-title" class="section-title">
          <span class="title-code font-mono">[03]</span> Digital Garden &amp; Zettelkasten
        </h2>
        <a href="/notes" class="section-more font-mono no-underline">
          explorar garden ({allNotes.length})
          <svg
            width="11"
            height="11"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="square"><path d="M7 17L17 7M7 7h10v10"></path></svg
          >
        </a>
      </div>

      <div class="garden-grid">
        {notes.map((note) => <NoteCard note={note} />)}
      </div>
    </section>

    <!-- Block 4: Documentary Photography & Field Notes Strip -->
    <section class="section-block" aria-labelledby="sec-field-title">
      <div class="section-header">
        <h2 id="sec-field-title" class="section-title">
          <span class="title-code font-mono">[04]</span> Notas de Campo &amp; Fotografia
          Documental
        </h2>
        <a href="/field-notes" class="section-more font-mono no-underline">
          ver arquivo ({allFieldNotes.length})
          <svg
            width="11"
            height="11"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="square"><path d="M7 17L17 7M7 7h10v10"></path></svg
          >
        </a>
      </div>

      <div class="field-strip">
        {
          fieldNotes.map((item) => (
            <FieldNoteCard entry={item} variant="compact" />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .index-flow {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  /* Top Header */
  .index-header {
    padding: 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .header-status-line {
    font-size: 0.78rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .prompt {
    color: var(--text);
    font-weight: 700;
  }

  .host {
    color: var(--text);
  }

  .badge {
    color: var(--text-dim);
    margin-left: auto;
  }

  .index-intro {
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--text);
    max-width: 760px;
    margin: 0;
  }

  .index-hire-badge {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text);
    background-color: var(--surface-secondary, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--border);
    padding: 0.45rem 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
  }

  .index-hire-badge .dot {
    color: #10b981;
    text-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  .quick-stats {
    font-size: 0.72rem;
    color: var(--text-dim);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-top: 0.5rem;
    border-top: var(--hairline);
  }

  .quick-stats a {
    color: inherit;
  }
  .quick-stats a:hover {
    color: var(--text);
  }

  /* Section Block */
  .section-block {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: var(--hairline);
    padding-bottom: 0.5rem;
  }

  .section-title {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0;
    padding: 0;
  }

  .title-code {
    color: var(--text-dim);
    font-size: 0.85rem;
    margin-right: 0.25rem;
  }

  .section-more {
    font-size: 0.78rem;
    color: var(--text-dim);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .section-more:hover {
    color: var(--text);
  }

  /* Featured Projects Grid */
  .featured-projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .featured-project-card {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background-color: var(--surface);
    transition: border-color var(--transition-fast);
  }

  .featured-project-card:hover {
    border-color: var(--border-strong);
  }

  .card-top {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border);
  }

  .card-meta {
    font-size: 0.72rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-dim);
  }

  .card-index {
    color: var(--text);
    font-weight: 700;
  }

  .card-cat {
    letter-spacing: 0.04em;
    color: var(--text-dim);
  }

  .card-badge-row {
    display: flex;
    align-items: center;
  }

  .card-badge {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text);
    background-color: var(--bg);
    border: 1px solid var(--border);
    padding: 0.2rem 0.55rem;
    line-height: 1.2;
    display: inline-flex;
    align-items: center;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-grow: 1;
  }

  .project-heading {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0;
    min-height: 2.85rem;
  }

  .project-title-link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    transition: text-decoration-color var(--transition-fast);
  }

  .project-title-link:hover {
    text-decoration-color: var(--text);
  }

  .project-summary {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .stack-chip {
    font-size: 0.7rem;
    background-color: var(--bg);
    border: 1px solid var(--border);
    padding: 0.15rem 0.45rem;
    color: var(--text-muted);
  }

  .stack-more {
    font-size: 0.7rem;
    color: var(--text-dim);
    align-self: center;
    padding-left: 0.2rem;
  }

  .project-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.75rem;
    border-top: var(--hairline);
    font-size: 0.75rem;
  }

  .action-link {
    color: var(--text);
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .action-link:hover {
    opacity: 0.7;
    text-decoration: underline;
  }

  .detail-link {
    margin-left: auto;
    color: var(--text-dim);
  }

  .detail-link:hover {
    color: var(--text);
  }

  /* Dense List */
  .dense-list {
    display: flex;
    flex-direction: column;
  }

  /* Garden Grid */
  .garden-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  /* Field Strip */
  .field-strip {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 680px) {
    .featured-projects-grid,
    .garden-grid,
    .field-strip {
      grid-template-columns: 1fr;
    }

    .detail-link {
      margin-left: 0;
    }
  }
</style>
