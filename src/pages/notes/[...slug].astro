---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Backlinks from "../../components/Backlinks.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { render } from "astro:content";
import { getSortedNotes } from "../../utils/content";
import { buildBacklinksIndex } from "../../utils/backlinks";
import { formatISODate } from "../../utils/date";

export async function getStaticPaths() {
  const allNotes = await getSortedNotes();
  const backlinksIndex = buildBacklinksIndex(allNotes);

  return allNotes.map((note) => ({
    params: { slug: note.id },
    props: {
      note,
      backlinks: backlinksIndex.get(note.id.toLowerCase().replace(/\.md$/, "")) || [],
    },
  }));
}

const { note, backlinks } = Astro.props;
const { Content } = await render(note);
---

<BaseLayout
  title={`${note.data.title} — Digital Garden`}
  description={note.data.description ||
    `Nota atômica ${note.id} no Digital Garden.`}
  type="article"
  publishDate={note.data.publishDate}
  updatedDate={note.data.updatedDate}
  tags={note.data.tags}
>
  <article class="note-container">
    <Breadcrumb
      backHref="/notes"
      backLabel="VOLTAR AO DIGITAL GARDEN"
      currentSlug={note.id}
      ariaLabel="Navegação do Garden"
    />

    <!-- Note Header -->
    <header class="note-header hairline-box">
      <div class="note-meta-line font-mono">
        <a
          href={`/notes?stage=${encodeURIComponent(note.data.stage)}`}
          class={`stage-pill stage-${note.data.stage}`}
          title={`Ver todas as notas em estágio [${note.data.stage.toUpperCase()}]`}
        >
          [{note.data.stage.toUpperCase()}]
        </a>
        <span class="meta-sep">•</span>
        <span class="meta-label">CRIADA:</span>
        <time datetime={note.data.publishDate.toISOString()} class="meta-val">
          {formatISODate(note.data.publishDate)}
        </time>
        {
          note.data.updatedDate && (
            <>
              <span class="meta-sep">•</span>
              <span class="meta-label">ÚLTIMA ATUALIZAÇÃO:</span>
              <time
                datetime={note.data.updatedDate.toISOString()}
                class="meta-val"
              >
                {formatISODate(note.data.updatedDate)}
              </time>
            </>
          )
        }
      </div>

      <h1 class="note-title">{note.data.title}</h1>

      {
        note.data.description && (
          <p class="note-desc">{note.data.description}</p>
        )
      }

      <div class="note-tags font-mono">
        {
          note.data.tags.map((tag) => (
            <a
              href={`/notes?tag=${encodeURIComponent(tag)}`}
              class="tag-mono"
              title={`Filtrar notas por #${tag}`}
            >
              #{tag}
            </a>
          ))
        }
      </div>
    </header>

    <!-- Note Body -->
    <div class="note-body prose-content">
      <Content />
    </div>

    <!-- Automatic Bidirectional Backlinks -->
    <Backlinks backlinks={backlinks} />
  </article>
</BaseLayout>

<style>
  .note-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 760px;
  }

  .note-header {
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .note-meta-line {
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .stage-pill {
    font-weight: 600;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .stage-pill:hover {
    opacity: 0.75;
    text-decoration: underline;
  }

  .stage-evergreen {
    color: var(--text);
  }
  .stage-growing {
    color: var(--text-muted);
  }
  .stage-seed {
    color: var(--text-dim);
  }

  .meta-label {
    color: var(--text-dim);
  }

  .meta-val {
    color: var(--text);
  }

  .meta-sep {
    color: var(--border-strong);
  }

  .note-title {
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }

  .note-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .note-body {
    font-size: 1rem;
    line-height: 1.65;
  }

  .note-body :global(h2) {
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .note-body :global(p) {
    margin-bottom: 1.25rem;
  }
</style>
