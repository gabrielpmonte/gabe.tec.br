---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../site.config";
import { PROJECTS } from "../data/projects";
import {
  getPublishedWritings,
  getSortedNotes,
  getSortedFieldNotes,
} from "../utils/content";

const writings = await getPublishedWritings();
const notes = await getSortedNotes();
const fieldNotes = await getSortedFieldNotes();

const localIndex = [
  ...writings.map((p) => ({
    url: `/writing/${p.id}`,
    title: p.data.title,
    category: "ARTIGO TÉCNICO",
    excerpt: p.data.description,
    tags: p.data.tags || [],
  })),
  ...notes.map((n) => ({
    url: `/notes/${n.id}`,
    title: n.data.title,
    category: "DIGITAL GARDEN",
    excerpt: n.data.description || "",
    tags: n.data.tags || [],
  })),
  ...fieldNotes.map((f) => ({
    url: `/field-notes/${f.id}`,
    title: f.data.title,
    category: "NOTAS DE CAMPO",
    excerpt: `${f.data.location} • ${f.data.gear?.camera || ""} ${f.data.gear?.lens || ""}`,
    tags: f.data.tags || [],
  })),
  ...PROJECTS.map((proj) => ({
    url: proj.liveUrl || proj.internalUrl || "/projects",
    title: proj.title,
    category: "PROJETO",
    excerpt: proj.description,
    tags: proj.stack || [],
  })),
  {
    url: "/projects",
    title: "Projetos de Engenharia & Demonstrações",
    category: "PORTFÓLIO",
    excerpt:
      "Aplicações web ativas (puzzles.gabe.tec.br), pesquisas em visão computacional na UERJ e homelab autônomo.",
    tags: [
      "puzzles",
      "homelab",
      "tachibana",
      "wired",
      "visao",
      "opencv",
      "docker",
      "caddy",
    ],
  },
  {
    url: "/curriculum",
    title: `Currículo Profissional (CV) — ${SITE.author}`,
    category: "CARREIRA",
    excerpt:
      "Graduando em Ciência da Computação (UERJ), foco em visão computacional, sistemas e disponibilidade profissional.",
    tags: [
      "cv",
      "curriculo",
      "uerj",
      "experiencia",
      "competencias",
      "estagio",
      "junior",
    ],
  },
  {
    url: "/about",
    title: `Sobre // ${SITE.author}`,
    category: "PERFIL",
    excerpt:
      "Síntese profissional, princípios operacionais de computação e canais diretos de contato.",
    tags: ["sobre", "bio", "uerj", "visao", "sistemas"],
  },
];
---

<BaseLayout
  title={`Busca Global — ${SITE.author}`}
  description="Busca em tempo real em artigos técnicos, notas de sistemas, registros de homelab e projetos."
>
  <div class="search-page-container">
    <header class="search-header hairline-box">
      <div class="header-path font-mono">
        // {SITE.domain.toUpperCase()} / SEARCH
      </div>
      <h1 class="search-title">Busca Global Indexada</h1>
      <p class="search-desc">
        Mecanismo de busca instantâneo para artigos técnicos, projetos, notas do
        jardim digital e registros de infraestrutura.
      </p>

      <div class="search-input-wrapper hairline-box">
        <span class="search-prompt font-mono">&gt;</span>
        <input
          type="search"
          id="search-input"
          class="search-input font-mono"
          placeholder="buscar: tachibana, puzzles, opencv, python, nixos, caddy..."
          autocomplete="off"
          aria-label="Buscar em artigos, notas e projetos"
        />
        <span class="search-status font-mono" id="search-status">[STANDBY]</span
        >
      </div>
    </header>

    <div id="search-results-area" class="results-area">
      <div
        id="search-placeholder"
        class="search-placeholder hairline-box font-mono"
      >
        // DIGITE QUALQUER TERMO ACIMA PARA BUSCAR NOS ARTIGOS E NOTAS.
      </div>

      <div id="search-results-list" class="results-list" style="display: none;">
      </div>
    </div>
  </div>

  <!-- Dados locais pré-compilados para busca instantânea imediata -->
  <script
    id="local-search-data"
    type="application/json"
    set:html={JSON.stringify(localIndex)}
  />
</BaseLayout>

<script src="../scripts/search-manager.ts"></script>

<style>
  .search-page-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .search-header {
    padding: 2.25rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background-color: var(--surface);
  }

  .header-path {
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .search-title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0;
  }

  .search-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 720px;
    margin: 0;
  }

  .search-input-wrapper {
    margin-top: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background-color: var(--bg);
    padding: 0.75rem 1.25rem;
  }

  .search-prompt {
    font-size: 1.1rem;
    color: var(--text-dim);
    font-weight: 700;
  }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 0.95rem;
    color: var(--text);
  }

  .search-input::placeholder {
    color: var(--text-dim);
    font-size: 0.88rem;
  }

  .search-status {
    font-size: 0.72rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .results-area {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .search-placeholder {
    padding: 2rem;
    font-size: 0.85rem;
    color: var(--text-dim);
    background-color: var(--surface);
    text-align: center;
  }

  .results-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(.result-card) {
    background-color: var(--surface);
    display: flex;
    flex-direction: column;
  }

  :global(.result-header) {
    padding: 0.5rem 1.25rem;
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
    font-size: 0.72rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  :global(.result-category) {
    color: var(--text-dim);
    font-weight: 600;
  }

  :global(.result-url) {
    color: var(--text-muted);
  }

  :global(.result-body) {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  :global(.result-title) {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
  }

  :global(.result-title a) {
    color: var(--text);
  }

  :global(.result-title a:hover) {
    text-decoration: underline;
  }

  :global(.result-excerpt) {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }

  :global(.result-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  :global(.tag-badge) {
    font-size: 0.7rem;
    color: var(--text-dim);
  }

  :global(.result-excerpt mark) {
    background-color: transparent;
    color: var(--text);
    font-weight: 700;
    text-decoration: underline;
  }
</style>
