---
interface Props {
  backHref?: string;
  backLabel?: string;
  topAnchor?: string;
  topLabel?: string;
}

const {
  backHref = "/writing",
  backLabel = "Voltar para /writing",
  topAnchor = "#main-content",
  topLabel = "Topo da Página",
} = Astro.props;
---

<footer class="article-colophon hairline-box">
  <div class="colophon-actions font-mono">
    <a href={backHref} class="colophon-btn font-mono no-underline">
      &larr; {backLabel}
    </a>
    <a href={topAnchor} class="colophon-btn font-mono no-underline">
      &uarr; {topLabel}
    </a>
  </div>
</footer>

<style>
  .article-colophon {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .colophon-actions {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .colophon-btn {
    font-size: 0.78rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 0.4rem 0.75rem;
    background-color: var(--bg);
    transition: all var(--transition-fast);
  }

  .colophon-btn:hover {
    border-color: var(--text);
    color: var(--text);
  }
</style>
