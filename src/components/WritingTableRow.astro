---
import type { CollectionEntry } from "astro:content";
import { formatISODate } from "../utils/date";
import {
  getArticleMetrics,
  getEffectiveUpdatedDate,
} from "../utils/writing-meta";

interface Props {
  post: CollectionEntry<"writing">;
  interactiveTags?: boolean;
}

const { post, interactiveTags = true } = Astro.props;
const { wordCount, readingMinutes } = getArticleMetrics(post);
const effectiveUpdatedDate = getEffectiveUpdatedDate(post);

const extras: string[] = [];
if (post.data.series) {
  const totalSuffix = post.data.series.total
    ? `/${post.data.series.total}`
    : "";
  extras.push(
    `SÉRIE: ${post.data.series.name.toUpperCase()} (${post.data.series.part}${totalSuffix})`,
  );
}
if (post.data.hasDemo) extras.push("DEMO INTERATIVA");
if (post.data.repoUrl) extras.push("CÓDIGO-FONTE");
---

<tr class="article-row hairline-divider" data-tags={post.data.tags.join(",")}>
  <td class="col-date font-mono">
    <time datetime={post.data.publishDate.toISOString()}>
      {formatISODate(post.data.publishDate)}
    </time>
    {
      effectiveUpdatedDate && (
        <time
          datetime={effectiveUpdatedDate.toISOString()}
          class="col-submeta"
          title={`Última edição em ${formatISODate(effectiveUpdatedDate)}`}
        >
          rev. {formatISODate(effectiveUpdatedDate)}
        </time>
      )
    }
  </td>
  <td class="col-title">
    <a href={`/writing/${post.id}`} class="post-link">
      {post.data.title}
    </a>
    <p class="post-desc">{post.data.description}</p>
    {
      extras.length > 0 && (
        <div class="post-extras font-mono">{extras.join(" • ")}</div>
      )
    }
  </td>
  <td class="col-tags font-mono">
    <div class="tags-container">
      {
        post.data.tags.map((t) =>
          interactiveTags ? (
            <button
              type="button"
              class="tag-mono tag-inline-btn"
              data-tag={t}
              title={`Filtrar por #${t}`}
            >
              #{t}
            </button>
          ) : (
            <a
              href={`/writing?tag=${encodeURIComponent(t)}`}
              class="tag-mono"
              title={`Ver artigos com #${t}`}
            >
              #{t}
            </a>
          ),
        )
      }
    </div>
  </td>
  <td class="col-time font-mono">
    <span>{`${readingMinutes} min`}</span>
    <span class="col-submeta">{`${wordCount} pal.`}</span>
  </td>
</tr>

<style>
  .article-row td {
    padding: 1rem 1rem;
    vertical-align: top;
    border-left: none;
    border-right: none;
  }

  .col-date {
    width: 105px;
    font-size: 0.8rem;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .col-title {
    min-width: 260px;
  }

  .post-link {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    display: block;
    margin-bottom: 0.25rem;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    transition: text-decoration-color var(--transition-fast);
  }

  .post-link:hover {
    text-decoration-color: var(--text);
  }

  .post-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0;
  }

  .col-submeta {
    display: block;
    font-size: 0.7rem;
    color: var(--text-dim);
    margin-top: 0.2rem;
    opacity: 0.85;
  }

  .post-extras {
    font-size: 0.7rem;
    color: var(--text-dim);
    margin-top: 0.45rem;
    letter-spacing: 0.02em;
  }

  .col-tags {
    width: 250px;
    min-width: 220px;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: flex-start;
  }

  .col-time {
    width: 55px;
    font-size: 0.78rem;
    color: var(--text-dim);
    text-align: right;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .col-tags,
    .col-time {
      display: none;
    }
  }
</style>
