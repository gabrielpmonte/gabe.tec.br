---
import { SITE } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: "website" | "article";
  publishDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  canonicalUrl?: string;
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  ogImage,
  type = "website",
  publishDate,
  updatedDate,
  tags = [],
  canonicalUrl,
} = Astro.props;

const canonicalURL = canonicalUrl
  ? new URL(canonicalUrl)
  : new URL(Astro.url.pathname, Astro.site);

const fullTitle = title.includes(SITE.author)
  ? title
  : `${title} — ${SITE.author}`;

// Auto-derive OG image path if not explicitly passed
const derivedOgImage =
  ogImage ||
  new URL(
    `/og${Astro.url.pathname === "/" ? "/index" : Astro.url.pathname}.png`,
    Astro.site,
  ).toString();

// Generate structured data (JSON-LD)
const isArticle = type === "article";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.author,
  url: SITE.url,
  image: derivedOgImage,
  email: SITE.email,
  jobTitle: SITE.headline,
  alumniOf: {
    "@type": "EducationalOrganization",
    name: SITE.education.institution,
  },
  knowsAbout: [
    "Computer Vision",
    "Machine Learning",
    "Python",
    "C++",
    "Linux / NixOS",
    "Docker",
    "Systems Architecture",
    "Computer Science",
  ],
  sameAs: [SITE.github.url, SITE.linkedin.url],
};

const schemaOrg = isArticle
  ? {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      headline: title,
      description: description,
      image: derivedOgImage,
      datePublished: publishDate?.toISOString(),
      dateModified: (updatedDate || publishDate)?.toISOString(),
      author: personSchema,
      publisher: personSchema,
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalURL.toString(),
      },
      keywords: tags.length > 0 ? tags.join(", ") : undefined,
    }
  : Astro.url.pathname.startsWith("/curriculum") ||
      Astro.url.pathname.startsWith("/about")
    ? personSchema
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: `${SITE.author} // ${SITE.title}`,
        url: SITE.url,
        description: SITE.bio,
        author: personSchema,
      };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light dark" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<meta name="robots" content="index, follow" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={`${SITE.author} // ${SITE.domain}`} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={derivedOgImage} />
{
  publishDate && (
    <meta
      property="article:published_time"
      content={publishDate.toISOString()}
    />
  )
}
{
  updatedDate && (
    <meta
      property="article:modified_time"
      content={updatedDate.toISOString()}
    />
  )
}

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={derivedOgImage} />
<meta name="twitter:creator" content={SITE.twitter.handle} />

<!-- Monochromatic Minimalist Vector Favicon -->
<link
  rel="icon"
  type="image/svg+xml"
  href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%2309090b'/%3E%3Cpath d='M8 10h16M8 16h10M8 22h14' stroke='%23fafafa' stroke-width='2' stroke-linecap='square'/%3E%3C/svg%3E"
/>

<!-- RSS Autodiscovery -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE.author}
  href={new URL("/rss.xml", Astro.site)}
/>

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
