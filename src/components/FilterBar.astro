---
interface FilterItem {
  id: string;
  label: string;
  count?: number;
}

interface Props {
  label: string;
  totalCount: number;
  items: FilterItem[];
  allLabel?: string;
  paramKey?: string;
  buttonClass?: string;
  listId?: string;
  maxVisible?: number;
}

const {
  label,
  totalCount,
  items,
  allLabel = "TODAS",
  paramKey = "tag",
  buttonClass = "tag-filter-btn",
  listId = "filter-list",
  maxVisible,
} = Astro.props;

const hiddenCount = maxVisible && items.length > maxVisible ? items.length - maxVisible : 0;
---

<div class="filter-controls font-mono">
  <span class="filter-label">{label}</span>
  <div class="filter-tags" id={listId}>
    <button
      type="button"
      class={`${buttonClass} is-active`}
      data-param={paramKey}
      data-value="all"
      data-tag="all"
      data-stage="all"
    >
      [{allLabel}: {totalCount}]
    </button>
    {
      items.map(({ id, label: itemLabel, count }, idx) => (
        <button
          type="button"
          class={buttonClass}
          data-param={paramKey}
          data-value={id}
          data-tag={id}
          data-stage={id}
          data-extra-item={maxVisible && idx >= maxVisible ? "true" : undefined}
          hidden={maxVisible && idx >= maxVisible ? true : undefined}
        >
          {itemLabel}
          {count !== undefined ? ` [${count}]` : ""}
        </button>
      ))
    }
    {
      hiddenCount > 0 && (
        <button
          type="button"
          class={`${buttonClass} filter-more-btn`}
          data-expand-list={listId}
          data-hidden-count={hiddenCount}
        >
          +{hiddenCount} tags
        </button>
      )
    }
  </div>
</div>

<script>
  function initFilterMore() {
    document.querySelectorAll<HTMLButtonElement>(".filter-more-btn").forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        const listId = btn.dataset.expandList;
        const container = listId ? document.getElementById(listId) : btn.parentElement;
        if (!container) return;
        const expanded = btn.dataset.expanded === "true";
        container.querySelectorAll<HTMLElement>("[data-extra-item='true']").forEach((el) => {
          el.hidden = expanded;
        });
        btn.dataset.expanded = expanded ? "false" : "true";
        btn.textContent = expanded ? `+${btn.dataset.hiddenCount} tags` : "mostrar menos";
      });
    });
  }
  document.addEventListener("astro:page-load", initFilterMore);
</script>

<style>
  .filter-controls {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: var(--hairline);
    font-size: 0.75rem;
  }

  .filter-label {
    color: var(--text-dim);
  }

  .filter-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-filter-btn,
  .stage-btn {
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
    background-color: var(--bg);
    border: 1px solid var(--border);
    color: var(--text-muted);
    cursor: pointer;
    font-family: inherit;
    transition: all var(--transition-fast);
  }

  .tag-filter-btn:hover,
  .stage-btn:hover {
    border-color: var(--text);
    color: var(--text);
  }

  .tag-filter-btn.is-active,
  .stage-btn.is-active {
    background-color: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
</style>
