---
import type { CollectionEntry } from "astro:content";
import { formatISODate } from "../utils/date";

interface Props {
  entry: CollectionEntry<"field_notes">;
  variant?: "full" | "compact";
  interactiveTags?: boolean;
  priority?: boolean | "high";
}

const {
  entry,
  variant = "full",
  interactiveTags = false,
  priority = false,
} = Astro.props;

const loadingMode = priority ? "eager" : "lazy";
const fetchPriority = priority === "high" ? "high" : "auto";
---

<article
  class={`field-item hairline-box ${variant === "compact" ? "field-compact" : ""}`}
  data-tags={entry.data.tags.join(",")}
>
  <a href={`/field-notes/${entry.id}`} class="field-img-link no-underline">
    <div class="img-container">
      {
        entry.data.coverImage && (
          <img
            src={entry.data.coverImage}
            alt={`Topografia de ${entry.data.title}`}
            loading={loadingMode}
            fetchpriority={fetchPriority}
            decoding="async"
            class="field-cover"
          />
        )
      }
      <div class="img-hud font-mono">
        <span class="hud-coords">{entry.data.coordinates}</span>
        {
          entry.data.elevation && (
            <span class="hud-alt">{entry.data.elevation}</span>
          )
        }
      </div>
    </div>
  </a>

  <div class="field-item-content">
    <div class="field-item-meta font-mono">
      <time datetime={entry.data.date.toISOString()}>
        {formatISODate(entry.data.date)}
      </time>
      <span class="meta-sep">•</span>
      <span class="meta-loc">{entry.data.location}</span>
    </div>

    <h2 class="field-item-title">
      <a href={`/field-notes/${entry.id}`} class="title-link">
        {entry.data.title}
      </a>
    </h2>

    <p class="field-item-summary">{entry.data.summary}</p>

    {
      variant === "full" ? (
        <div class="field-item-specs font-mono">
          <div class="spec-row">
            <span class="spec-label">CAMERA:</span>
            <span class="spec-val">{entry.data.gear.camera}</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">OPTICS:</span>
            <span class="spec-val">{entry.data.gear.lens}</span>
          </div>
          {entry.data.gear.simulation && (
            <div class="spec-row">
              <span class="spec-label">PERFIL:</span>
              <span class="spec-val">{entry.data.gear.simulation}</span>
            </div>
          )}
        </div>
      ) : (
        <div class="field-optics-compact font-mono">
          <span>{entry.data.gear.camera}</span>
          <span>•</span>
          <span>{entry.data.gear.lens}</span>
        </div>
      )
    }

    {
      entry.data.tags.length > 0 && variant === "full" && (
        <div class="field-item-tags font-mono">
          {entry.data.tags.map((t) =>
            interactiveTags ? (
              <button
                type="button"
                class="tag-mono tag-inline-btn"
                data-tag={t}
                title={`Filtrar expedições por #${t}`}
              >
                #{t}
              </button>
            ) : (
              <a
                href={`/field-notes?tag=${encodeURIComponent(t)}`}
                class="tag-mono"
                title={`Filtrar por #${t}`}
              >
                #{t}
              </a>
            ),
          )}
        </div>
      )
    }
  </div>
</article>

<style>
  .field-item {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .field-img-link {
    display: block;
    border-bottom: var(--hairline);
  }

  .img-container {
    position: relative;
    aspect-ratio: 16 / 9;
    background-color: var(--surface-subtle);
    overflow: hidden;
  }

  .field-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.1);
    transition:
      filter var(--transition-medium),
      transform var(--transition-medium);
    display: block;
  }

  .field-item:hover .field-cover {
    filter: grayscale(0%) contrast(1);
    transform: scale(1.02);
  }

  .img-hud {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.4rem 0.65rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
    color: #ffffff;
    font-size: 0.68rem;
    display: flex;
    justify-content: space-between;
  }

  .field-item-content {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-grow: 1;
  }

  .field-item-meta {
    font-size: 0.72rem;
    color: var(--text-dim);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .field-item-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .title-link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    transition: text-decoration-color var(--transition-fast);
  }

  .title-link:hover {
    text-decoration-color: var(--text);
  }

  .field-item-summary {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin: 0;
    flex-grow: 1;
  }

  .field-item-specs {
    font-size: 0.72rem;
    color: var(--text-dim);
    background-color: var(--bg);
    border: 1px solid var(--border);
    padding: 0.5rem 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .field-optics-compact {
    font-size: 0.72rem;
    color: var(--text-dim);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border-top: var(--hairline);
    padding-top: 0.5rem;
  }

  .spec-row {
    display: flex;
    gap: 0.4rem;
  }

  .spec-label {
    color: var(--text-dim);
    width: 65px;
  }

  .spec-val {
    color: var(--text);
  }

  .field-item-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }
</style>
