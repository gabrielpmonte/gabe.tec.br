---
// src/components/sidebar/Sidebar.astro
import { SITE } from "../../site.config";
import { formatTimezoneMeta } from "../../utils/date";
import SidebarHeader from "./SidebarHeader.astro";
import SidebarNav from "./SidebarNav.astro";
import SidebarChannels from "./SidebarChannels.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<aside id="header-sidebar" class="sidebar">
  <div class="sidebar-inner">
    <!-- Header / Identidade -->
    <SidebarHeader />

    <!-- Navegação Modular -->
    <SidebarNav currentPath={currentPath} />

    <!-- Conexões Externas -->
    <SidebarChannels />

    <!-- Rodapé & Controles -->
    <footer class="sidebar-footer">
      <ThemeToggle />
      <div class="sys-meta font-mono">
        <div>{formatTimezoneMeta(SITE.timezone.iana, SITE.timezone.label)}</div>
        <div>NO COOKIES // ZERO TRACKERS</div>
      </div>
    </footer>
  </div>
</aside>

<style>
  .sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    border-right: var(--hairline);
    background-color: var(--surface);
    display: flex;
    flex-direction: column;
  }

  .sidebar-inner {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .sidebar-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 1.5rem;
    border-top: var(--hairline);
  }

  .sys-meta {
    font-size: 0.68rem;
    color: var(--text-dim);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  @media (max-width: 960px) {
    .sidebar {
      width: 100%;
      border-right: none;
      border-bottom: var(--hairline);
    }

    .sidebar-inner {
      position: static;
      height: auto;
      padding: 1.5rem 1.25rem;
      gap: 1.5rem;
    }
  }
</style>
